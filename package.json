{
	"name": "nestjs-swagger-koa",
	"description": "NestJS module for generating Swagger documentation for Koa applications",
	"version": "1.2.2",
	"type": "module",
	"scripts": {
		"build": "rimraf dist && tsc -p tsconfig.build.json",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"prepublish:npm": "npm run build",
		"publish:npm": "release-it",
		"prepublish:dev": "npm run build",
		"publish:dev": "npm publish --access public --tag dev",
		"prepare": "husky",
		"format": "prettier --write \"{src,apps,libs,test}/**/*.ts\"",
		"lint": "oxlint --type-aware --deny-warnings src test",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"test:ci": "vitest run --coverage"
	},
	"lint-staged": {
		"*.ts": "npm run format"
	},
	"directories": {
		"lib": "src",
		"test": "test"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"nestjs",
		"swagger",
		"koa",
		"adapter"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SocketSomeone/nestjs-swagger-koa.git"
	},
	"bugs": {
		"url": "https://github.com/SocketSomeone/nestjs-swagger-koa/issues"
	},
	"author": "Alexey Filippov <socket.someone@gmail.com>",
	"contributors": [
		"Alexey Filippov <socket.someone@gmail.com>"
	],
	"dependencies": {
		"koa-mount": "^4.0.0",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-angular": "21.2.2",
		"@nestjs/common": "10.4.22",
		"@nestjs/core": "10.4.22",
		"@nestjs/swagger": "7.4.2",
		"@nestjs/testing": "10.4.22",
		"@release-it/conventional-changelog": "^12.0.0",
		"@types/node": "26.4.0",
		"@vitest/coverage-v8": "4.1.11",
		"eslint": "^10.0.0",
		"eslint-plugin-perfectionist": "5.11.0",
		"eslint-plugin-prettier": "5.5.6",
		"husky": "9.1.7",
		"lint-staged": "17.4.1",
		"nest-koa-adapter": "4.0.1",
		"oxlint": "1.81.0",
		"oxlint-tsgolint": "7.0.2001",
		"prettier": "3.9.6",
		"reflect-metadata": "0.2.2",
		"release-it": "21.0.2",
		"rimraf": "6.1.3",
		"rxjs": "7.8.2",
		"ts-node": "10.9.2",
		"typescript": "7.0.2",
		"vitest": "4.1.11"
	},
	"peerDependencies": {
		"@nestjs/common": "^10.0.0",
		"@nestjs/core": "^10.0.0",
		"@nestjs/swagger": "^7.4.2",
		"nest-koa-adapter": "^4.0.1",
		"reflect-metadata": "^0.2.1",
		"rxjs": "^7.2.0"
	},
	"engines": {
		"node": "^20.19.0 || >=22.13.0",
		"npm": ">=8.6.0"
	}
}
